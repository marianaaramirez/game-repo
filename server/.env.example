# ============================================================
# Math Smash backend — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mathsmash

# JWT signing secret. Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Same secret must be used for issuing AND verifying tokens.
JWT_SECRET=

# Backend HTTP port
PORT=3000

# Node environment. Use 'production' to disable verbose logging.
NODE_ENV=development
